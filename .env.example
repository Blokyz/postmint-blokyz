# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://postmint:postmint@localhost:15432/postmint
REDIS_URL=redis://localhost:6379/0

# Moralis (https://moralis.io — free tier 40 req/s)
MORALIS_API_KEY=
# Pause (seconds) between Moralis requests; default 0.025 matches the free tier.
# Lower or 0 on paid plans.
MORALIS_RATE_SLEEP=0.025

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# Public address of BACKEND_SIGNER_PRIVATE_KEY — passed to the ManifestRegistry
# constructor at deploy so the contract knows which signer to trust.
BACKEND_SIGNER_ADDRESS=

# Backend signer — signs ManifestRegistry lock attestations (Wave 2) and, later,
# Phase 3 claim proofs. No funds needed (it never sends transactions).
BACKEND_SIGNER_PRIVATE_KEY=

# On-chain lock attestation binding (backend). Set MANIFEST_REGISTRY_ADDRESS to
# the deployed ManifestRegistry; CHAIN_ID must match the deploy chain (Base
# Sepolia = 84532). These bind each attestation to this exact deployment.
MANIFEST_REGISTRY_ADDRESS=
CHAIN_ID=84532

# Operator authorization (ENFORCE-WHEN-CONFIGURED — leave EMPTY in dev, SET BEFORE
# MAINNET). OPERATOR_ALLOWLIST is a comma-separated list of wallet addresses
# permitted to start ingestions (POST /audit/ingest), approve rankings
# (POST /audit/approve) and publish collections (POST /collections); enforced
# against the recovered EIP-191 signer.
# OPERATOR_API_TOKEN is a shared bearer token gating server-to-server season
# registration (POST /claims/season, called by the deploy script).
OPERATOR_ALLOWLIST=
OPERATOR_API_TOKEN=
# Freshness window (seconds) for signed ingest authorizations — the ingest
# message binds an issued_at timestamp; older signatures are rejected.
INGEST_SIG_TTL_SECONDS=300

# In-process TTL cache (seconds) for the standings/directory rollup endpoints
# (polled by every open holder page). Claim submits/confirms invalidate their
# contract immediately; 0 disables the cache entirely.
STANDINGS_CACHE_TTL_SECONDS=30

# Celery beat cadence (seconds): transfer poller / Claimed-event reconciler
# across all published collections. Only fires when a beat process is running
# (backend/scripts/run_celery_beat.ps1); 0 removes that schedule entry.
TRANSFER_POLL_INTERVAL_SECONDS=180
RECONCILE_INTERVAL_SECONDS=600

# Frontend (after deploy)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MANIFEST_REGISTRY_ADDRESS=
